# Obrigatória na primeira execução. Depois, a senha também pode ser definida pelo painel.
ADMIN_PASSWORD=troque-esta-senha

# Use uma string longa e aleatória em produção para assinar o cookie do painel.
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Opcionais: também podem ser definidos e alterados no painel /admin.
# Se o campo correspondente no JSON estiver vazio, estes valores são utilizados.
DISCORD_WEBHOOK_URL=
PUSHCUT_URL=https://api.pushcut.io/v1/notifications/NomeDaNotificacao
PUSHCUT_API_KEY=
